/*
 * GCS bucket kcd-2026-kcd-demo (demo: create a bucket through a PR). Raw
 * forma: stack, target and resource in this one file (same shape as
 * `formae extract`), no shared modules.
 *
 * One stack per forma folder: a reconcile apply deletes any resource in the
 * stack that this file does not declare, so don't reuse the stack label.
 * Labels: stack = <project>/<forma folder>, target = <project>.
 */
extends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@gcp/gcp.pkl"
import "@gcp/storage/bucket.pkl"

forma {
  new formae.Stack {
    label = "kcd-2026/bucket/kcd-demo"
    description = "GCS bucket kcd-demo for kcd-2026"
  }

  new formae.Target {
    label = "kcd-2026"
    config = new gcp.Config {
      project = "kcd-2026"
      region = "asia-southeast2"
    }
  }

  new bucket.Bucket {
    label = "kcd-demo"
    name = "kcd-2026-kcd-demo"   // bucket names are global: prefix with the project
    location = "asia-southeast2"
    storageClass = "STANDARD"
    versioning = new bucket.Versioning { enabled = true }
    labels {
      ["project"] = "kcd-2026"
      ["component"] = "kcd-demo"
      ["environment"] = "stg"
    }
  }
}
