 `kcd2026/gkeResearchLab`

 new Service.Service {
  label = "service-mario"
  apiVersion = "v1"
  kind = "Service"
  metadata = new shared.NamespacedObjectMeta {
   name = "mario"
   namespace = new formae.Resolvable { label = "namespace-mario"; type = "K8S::Core::Namespace"; stack = "kcd-2026/kube-manifest/mario"; property = "metadata.name" }
   annotations = new Mapping {
    ["cloud.google.com/neg"] = "{\"ingress\":true}"
   }
  }
  spec = new Service.ServiceSpec {
   ipFamilyPolicy = "SingleStack"
   sessionAffinity = "None"
   ports = new Listing { new Service.ServicePort {
     protocol = "TCP"
     port = 80
     name = "port"
     targetPort = 80
    } }
   type = "ClusterIP"
   selector = new Mapping {
    ["app"] = "mario"
   }
   internalTrafficPolicy = "Cluster"
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/mario" }
 }

 new Namespace.Namespace {
  label = "namespace-mario"
  apiVersion = "v1"
  kind = "Namespace"
  metadata = new Namespace.NamespaceMetadata {
   name = "mario"
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/mario" }
 }

 new Deployment.Deployment {
  label = "deployment-mario"
  apiVersion = "apps/v1"
  kind = "Deployment"
  metadata = new shared.NamespacedObjectMeta {
   name = "mario"
   namespace = new formae.Resolvable { label = "namespace-mario"; type = "K8S::Core::Namespace"; stack = "kcd-2026/kube-manifest/mario"; property = "metadata.name" }
   labels = new Mapping {
    ["app"] = "mario"
   }
  }
  spec = new Deployment.DeploymentSpec {
   template = new k8s.PodTemplateSpec {
    metadata = new k8s.PodTemplateMetadata {
     labels = new Mapping {
      ["app"] = "mario"
     }
    }
    spec = new k8s.PodSpec {
     dnsPolicy = "ClusterFirst"
     terminationGracePeriodSeconds = 30
     securityContext = new k8s.PodSecurityContext {

     }
     schedulerName = "default-scheduler"
     restartPolicy = "Always"
     containers = new Listing { new k8s.Container {
       image = "guopingjia/mario:cfe-demo"
       terminationMessagePolicy = "File"
       terminationMessagePath = "/dev/termination-log"
       resources = new k8s.ResourceRequirements {
        requests = new Mapping {
         ["cpu"] = "50m"
         ["memory"] = "64Mi"
        }
        limits = new Mapping {
         ["cpu"] = "200m"
         ["memory"] = "128Mi"
        }
       }
       ports = new Listing { new k8s.ContainerPort {
         protocol = "TCP"
         containerPort = 80
        } }
       name = "mario"
      } }
    }
   }
   replicas = 2
   revisionHistoryLimit = 10
   selector = new k8s.LabelSelector {
    matchLabels = new Mapping {
     ["app"] = "mario"
    }
   }
   strategy = new Deployment.DeploymentStrategy {
    type = "RollingUpdate"
    rollingUpdate = new Deployment.RollingUpdateDeployment {
     maxSurge = "25%"
     maxUnavailable = "25%"
    }
   }
   progressDeadlineSeconds = 600
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/mario" }
 }

 new HorizontalPodAutoscaler.HorizontalPodAutoscaler {
  label = "hpa-mario"
  apiVersion = "autoscaling/v2"
  kind = "HorizontalPodAutoscaler"
  metadata = new shared.NamespacedObjectMeta {
   name = "mario"
   namespace = new formae.Resolvable { label = "namespace-mario"; type = "K8S::Core::Namespace"; stack = "kcd-2026/kube-manifest/mario"; property = "metadata.name" }
  }
  spec = new HorizontalPodAutoscaler.HorizontalPodAutoscalerSpec {
   maxReplicas = 6
   minReplicas = 1
   metrics = new Listing { new HorizontalPodAutoscaler.MetricSpec {
     resource = new HorizontalPodAutoscaler.ResourceMetricSource {
      name = "cpu"
      target = new HorizontalPodAutoscaler.MetricTarget {
       averageUtilization = 70
       type = "Utilization"
      }
     }
     type = "Resource"
    } }
   scaleTargetRef = new HorizontalPodAutoscaler.CrossVersionObjectReference {
    apiVersion = "apps/v1"
    kind = "Deployment"
    name = "mario"
   }
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/mario" }
 }
