forma {

 local `kcd2026/kubeManifest/promo` = new formae.Stack {
  label = "kcd-2026/kube-manifest/promo"
  description = "promo demo app in namespace kcd-demo (GKE gke-research-lab)"
 }
 `kcd2026/kubeManifest/promo`


 local `kcd2026/gkeResearchLab` = new formae.Target {
  label = "kcd-2026/gke-research-lab"
  namespace = "K8S"
  reap = new formae.ReapAfter { maxUnreachable = 86400.s }
  discoverable = true
  config = new _formaeDesiredConfig_0 {
   `ApiVersion` = "v1.35"
   `Auth` = new Mapping {
    ["CertificateAuthority"] = new formae.Resolvable { label = "gke-research-lab"; type = "GCP::Container::Cluster"; stack = "$unmanaged"; property = "masterAuth.clusterCaCertificate" }
    ["ClusterName"] = "gke-research-lab"
    ["Endpoint"] = new formae.Resolvable { label = "gke-research-lab"; type = "GCP::Container::Cluster"; stack = "$unmanaged"; property = "endpoint" }
    ["Location"] = "asia-southeast2-a"
    ["ProjectId"] = "kcd-2026"
    ["Type"] = "GKE"
   }
   `Type` = "K8S"
  }
 }
 `kcd2026/gkeResearchLab`

 new Deployment.Deployment {
  label = "promo-worker"
  apiVersion = "apps/v1"
  kind = "Deployment"
  metadata = new shared.NamespacedObjectMeta {
   name = "promo-worker"
   namespace = new formae.Resolvable { label = "namespace-kcd-demo"; type = "K8S::Core::Namespace"; stack = "kcd-2026/kube-manifest/promo"; property = "metadata.name" }
   labels = new Mapping {
    ["app"] = "promo-worker"
    ["managed-by"] = "formae"
   }
  }
  spec = new Deployment.DeploymentSpec {
   template = new k8s.PodTemplateSpec {
    metadata = new k8s.PodTemplateMetadata {
     labels = new Mapping {
      ["app"] = "promo-worker"
      ["managed-by"] = "formae"
     }
    }
    spec = new k8s.PodSpec {
     dnsPolicy = "ClusterFirst"
     terminationGracePeriodSeconds = 30
     securityContext = new k8s.PodSecurityContext {

     }
     schedulerName = "default-scheduler"
     restartPolicy = "Always"
     containers = new Listing { new k8s.Container {
       image = "mirror.gcr.io/library/busybox:1.36"
       terminationMessagePolicy = "File"
       terminationMessagePath = "/dev/termination-log"
       resources = new k8s.ResourceRequirements {
        requests = new Mapping {
         ["cpu"] = "10m"
         ["memory"] = "16Mi"
        }
        limits = new Mapping {
         ["cpu"] = "50m"
         ["memory"] = "256Mi"
        }
       }
       command = new Listing { "sh"; "-c" }
       args = new Listing { "echo \"loading promo cache (100Mi)\"; awk 'BEGIN { cache = sprintf(\"%104857600s\", \"\"); print \"promo cache loaded\"; system(\"while true; do echo worker ok; sleep 30; done\") }'" }
       name = "promo-worker"
      } }
    }
   }
   replicas = 1
   revisionHistoryLimit = 10
   selector = new k8s.LabelSelector {
    matchLabels = new Mapping {
     ["app"] = "promo-worker"
     ["managed-by"] = "formae"
    }
   }
   strategy = new Deployment.DeploymentStrategy {
    type = "RollingUpdate"
    rollingUpdate = new Deployment.RollingUpdateDeployment {
     maxSurge = "25%"
     maxUnavailable = "25%"
    }
   }
   progressDeadlineSeconds = 600
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/promo" }
 }

 new ConfigMap.ConfigMap {
  label = "promo-config"
  apiVersion = "v1"
  kind = "ConfigMap"
  metadata = new shared.NamespacedObjectMeta {
   name = "promo-config"
   namespace = new formae.Resolvable { label = "namespace-kcd-demo"; type = "K8S::Core::Namespace"; stack = "kcd-2026/kube-manifest/promo"; property = "metadata.name" }
   labels = new Mapping {
    ["app"] = "promo-api"
    ["managed-by"] = "formae"
   }
  }
  data = new Mapping {
   ["DISCOUNT_PCT"] = "10"
   ["PROMO_ENABLED"] = "false"
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/promo" }
 }

 new Namespace.Namespace {
  label = "namespace-kcd-demo"
  apiVersion = "v1"
  kind = "Namespace"
  metadata = new Namespace.NamespaceMetadata {
   name = "kcd-demo"
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/promo" }
 }

 new Deployment.Deployment {
  label = "promo-api"
  apiVersion = "apps/v1"
  kind = "Deployment"
  metadata = new shared.NamespacedObjectMeta {
   name = "promo-api"
   namespace = new formae.Resolvable { label = "namespace-kcd-demo"; type = "K8S::Core::Namespace"; stack = "kcd-2026/kube-manifest/promo"; property = "metadata.name" }
   labels = new Mapping {
    ["app"] = "promo-api"
    ["managed-by"] = "formae"
   }
  }
  spec = new Deployment.DeploymentSpec {
   template = new k8s.PodTemplateSpec {
    metadata = new k8s.PodTemplateMetadata {
     labels = new Mapping {
      ["app"] = "promo-api"
      ["managed-by"] = "formae"
     }
    }
    spec = new k8s.PodSpec {
     dnsPolicy = "ClusterFirst"
     terminationGracePeriodSeconds = 30
     securityContext = new k8s.PodSecurityContext {

     }
     schedulerName = "default-scheduler"
     restartPolicy = "Always"
     containers = new Listing { new k8s.Container {
       image = "mirror.gcr.io/library/busybox:1.36"
       terminationMessagePolicy = "File"
       terminationMessagePath = "/dev/termination-log"
       resources = new k8s.ResourceRequirements {
        requests = new Mapping {
         ["cpu"] = "10m"
         ["memory"] = "16Mi"
        }
        limits = new Mapping {
         ["cpu"] = "50m"
         ["memory"] = "64Mi"
        }
       }
       command = new Listing { "sh"; "-c" }
       args = new Listing { "while true; do echo \"PROMO_ENABLED=$PROMO_ENABLED DISCOUNT_PCT=$DISCOUNT_PCT\"; sleep 30; done" }
       name = "promo-api"
       envFrom = new Listing { new k8s.EnvFromSource {
         configMapRef = new k8s.ConfigMapEnvSource {
          name = "promo-config"
         }
        } }
      } }
    }
   }
   replicas = 1
   revisionHistoryLimit = 10
   selector = new k8s.LabelSelector {
    matchLabels = new Mapping {
     ["app"] = "promo-api"
     ["managed-by"] = "formae"
    }
   }
   strategy = new Deployment.DeploymentStrategy {
    type = "RollingUpdate"
    rollingUpdate = new Deployment.RollingUpdateDeployment {
     maxSurge = "25%"
     maxUnavailable = "25%"
    }
   }
   progressDeadlineSeconds = 600
  }
  target = new formae.TargetResolvable { label = "kcd-2026/gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-2026/kube-manifest/promo" }
 }
