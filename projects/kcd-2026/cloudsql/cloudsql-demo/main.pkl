extends "@formae/forma.pkl"
import "@formae/formae.pkl"

// Resource imports
import "@gcp/sql/database.pkl" as database
import "@gcp/gcp.pkl" as gcp

local class _formaeDesiredConfig_0 {
 `Project`: Any
 `Region`: Any
 `Type`: Any
 @formae.ConfigFieldHint { createOnly = false }
 hidden `Auth`: Any = null
}

forma {

 local `kcd2026/cloudsql/cloudsqlDemo` = new formae.Stack {
  label = "kcd-2026/cloudsql/cloudsql-demo"
  description = "Cloud SQL cloudsql-demo for kcd-2026"
 }
 `kcd2026/cloudsql/cloudsqlDemo`


 local kcd2026 = new formae.Target {
  label = "kcd-2026"
  namespace = "GCP"
  reap = new formae.ReapAfter { maxUnreachable = 86400.s }
  discoverable = true
  config = new _formaeDesiredConfig_0 {
   `Project` = "kcd-2026"
   `Region` = "asia-southeast2"
   `Type` = "GCP"
  }
 }
 kcd2026

 new database.DatabaseInstance {
  label = "cloudsql-demo"
  project = "kcd-2026"
  name = "cloudsql-demo"
  databaseVersion = "POSTGRES_18"
  region = "asia-southeast2"
  settings = new database.Settings {
   tier = "db-g1-small"
   availabilityType = "ZONAL"
   dataDiskSizeGb = 10
   dataDiskType = "PD_SSD"
   storageAutoResize = true
   userLabels = new Mapping {
    ["component"] = "cloudsql-demo"
    ["drift-test"] = "kcd"
    ["environment"] = "stg"
    ["project"] = "kcd-2026"
   }
   ipConfiguration = new database.IpConfiguration {
    ipv4Enabled = true
    requireSsl = false
    authorizedNetworks = new Listing {  }
    sslMode = "ALLOW_UNENCRYPTED_AND_ENCRYPTED"
    serverCaMode = "GOOGLE_MANAGED_INTERNAL_CA"
    serverCertificateRotationMode = "SERVER_CERTIFICATE_ROTATION_MODE_UNSPECIFIED"
   }
   backupConfiguration = new database.BackupConfiguration {
    enabled = true
    pointInTimeRecoveryEnabled = true
    backupRetentionSettings = new database.BackupRetentionSettings {
     retainedBackups = 7
     retentionUnit = "COUNT"
    }
    startTime = "08:00"
    kind = "sql#backupConfiguration"
    backupTier = "STANDARD"
    transactionLogRetentionDays = 7
    transactionalLogStorageState = "CLOUD_STORAGE"
   }
   maintenanceWindow = new database.MaintenanceWindow {
    day = 6
    hour = 18
    updateTrack = "stable"
   }
   databaseFlags = new Listing { new database.DatabaseFlag {
     name = "max_connections"
     value = "100"
    }; new database.DatabaseFlag {
     name = "cloudsql.iam_authentication"
     value = "on"
    } }
   activationPolicy = "ALWAYS"
   authorizedGaeApplications = new Listing {  }
   connectorEnforcement = "NOT_REQUIRED"
   deletionProtectionEnabled = true
   edition = "ENTERPRISE"
   enableDataplexIntegration = true
   kind = "sql#settings"
   locationPreference = new Mapping {
    ["kind"] = "sql#locationPreference"
    ["zone"] = "asia-southeast2-c"
   }
   pricingPlan = "PER_USE"
   replicationLagMaxSeconds = 31536000
   replicationType = "SYNCHRONOUS"
   settingsVersion = "9"
   storageAutoResizeLimit = "0"
  }
  target = new formae.TargetResolvable { label = "kcd-2026" }
  stack = new formae.StackResolvable { label = "kcd-2026/cloudsql/cloudsql-demo" }
 }
}