extends "@formae/forma.pkl"
import "@formae/formae.pkl"

// Resource imports
import "@k8s/v1.36/core/ConfigMap.pkl" as ConfigMap
import "@k8s/v1.36/apps/Deployment.pkl" as Deployment
// Dependency imports
import "@k8s/shared.pkl" as shared
import "@k8s/v1.36/k8s.pkl" as k8s

local class _formaeDesiredConfig_0 {
 `ApiVersion`: Any
 @formae.ConfigFieldHint { createOnly = true }
 `Auth`: Any
 `Type`: Any
 @formae.ConfigFieldHint { createOnly = false }
 hidden `KubernetesVersion`: Any = null
}

forma {

 local kcdDemoApp = new formae.Stack {
  label = "kcd-demo-app"
  description = "KCD demo: G1 ConfigMap promo + G2 memory limit"
 }
 kcdDemoApp


 local k8sGkeResearchLab = new formae.Target {
  label = "k8s-gke-research-lab"
  namespace = "K8S"
  reap = new formae.ReapAfter { maxUnreachable = 86400.s }
  discoverable = true
  config = new _formaeDesiredConfig_0 {
   `ApiVersion` = "v1.35"
   `Auth` = new Mapping {
    ["CertificateAuthority"] = ""
    ["ClusterName"] = "gke-research-lab"
    ["Endpoint"] = "https://34.50.120.71"
    ["Location"] = "asia-southeast2-a"
    ["ProjectId"] = "kcd-2026"
    ["Type"] = "GKE"
   }
   `Type` = "K8S"
  }
 }
 k8sGkeResearchLab

 new ConfigMap.ConfigMap {
  label = "promo-config"
  apiVersion = "v1"
  kind = "ConfigMap"
  metadata = new shared.NamespacedObjectMeta {
   name = "promo-config"
   namespace = "kcd-demo"
   labels = new Mapping {
    ["app"] = "promo-api"
    ["managed-by"] = "formae"
   }
  }
  data = new Mapping {
   ["DISCOUNT_PCT"] = "10"
   ["PROMO_ENABLED"] = "false"
  }
  target = new formae.TargetResolvable { label = "k8s-gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-demo-app" }
 }

 new Deployment.Deployment {
  label = "promo-api"
  apiVersion = "apps/v1"
  kind = "Deployment"
  metadata = new shared.NamespacedObjectMeta {
   name = "promo-api"
   namespace = "kcd-demo"
   labels = new Mapping {
    ["app"] = "promo-api"
    ["managed-by"] = "formae"
   }
  }
  spec = new Deployment.DeploymentSpec {
   template = new k8s.PodTemplateSpec {
    metadata = new k8s.PodTemplateMetadata {
     labels = new Mapping {
      ["app"] = "promo-api"
      ["managed-by"] = "formae"
     }
    }
    spec = new k8s.PodSpec {
     dnsPolicy = "ClusterFirst"
     terminationGracePeriodSeconds = 30
     schedulerName = "default-scheduler"
     restartPolicy = "Always"
     containers = new Listing { new k8s.Container {
       image = "mirror.gcr.io/library/busybox:1.36"
       terminationMessagePolicy = "File"
       terminationMessagePath = "/dev/termination-log"
       resources = new k8s.ResourceRequirements {
        requests = new Mapping {
         ["cpu"] = "10m"
         ["memory"] = "16Mi"
        }
        limits = new Mapping {
         ["cpu"] = "50m"
         ["memory"] = "64Mi"
        }
       }
       command = new Listing { "sh"; "-c" }
       args = new Listing { "while true; do echo \"PROMO_ENABLED=$PROMO_ENABLED DISCOUNT_PCT=$DISCOUNT_PCT\"; sleep 30; done" }
       name = "promo-api"
       envFrom = new Listing { new k8s.EnvFromSource {
         configMapRef = new k8s.ConfigMapEnvSource {
          name = "promo-config"
         }
        } }
      } }
    }
   }
   replicas = 1
   revisionHistoryLimit = 10
   selector = new k8s.LabelSelector {
    matchLabels = new Mapping {
     ["app"] = "promo-api"
     ["managed-by"] = "formae"
    }
   }
   progressDeadlineSeconds = 600
  }
  target = new formae.TargetResolvable { label = "k8s-gke-research-lab" }
  stack = new formae.StackResolvable { label = "kcd-demo-app" }
 }
}